  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Pale capsule action with a drawn arrow and a small hover lift.",
      "html": "<button class=\"ds-primary\">Обсудить проект<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:24px;border:0;border-radius:40px;min-height:48px;padding:13px 21px;background:var(--studio-ink);color:#171718;font:500 13px/1.4 Manrope,Arial,sans-serif;cursor:pointer;box-shadow:none;transition:background .2s,transform .3s cubic-bezier(.16,1,.3,1)}.ds-primary svg{width:17px;height:17px}.ds-primary:hover{background:#dddddf;transform:translateY(-2px)}.ds-primary:active{transform:translateY(0)}.ds-primary:focus-visible,.ds-text-action:focus-visible,.ds-nav a:focus-visible,.ds-tab:focus-visible,.ds-disclosure summary:focus-visible,.ds-caption:focus-visible{outline:2px solid var(--studio-accent);outline-offset:5px}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "text-action",
      "description": "A quiet secondary link with a drawn arrow and an underline on hover.",
      "html": "<a class=\"ds-text-action\" href=\"#works\">Смотреть работы<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a>",
      "css": ".ds-text-action{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:var(--studio-ink);font:400 14px/1.4 Manrope,Arial,sans-serif;text-decoration:none;text-underline-offset:5px}.ds-text-action svg{width:17px;height:17px}.ds-text-action:hover{text-decoration:underline;color:#fff}.ds-primary:focus-visible,.ds-text-action:focus-visible,.ds-nav a:focus-visible,.ds-tab:focus-visible,.ds-disclosure summary:focus-visible,.ds-caption:focus-visible{outline:2px solid var(--studio-accent);outline-offset:5px}"
    },
    {
      "name": "Capsule navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Borderless translucent navigation with visible hover and current states.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Основная навигация\"><a href=\"#works\">Работы</a><a href=\"#services\" aria-current=\"page\">Услуги</a><a href=\"#approach\">Процесс</a></nav>",
      "css": ".ds-nav{display:inline-flex;align-items:center;gap:3px;border:0;border-radius:40px;padding:6px;background:#ffffff0a;backdrop-filter:blur(22px) saturate(110%);font:400 13px/1.6 Manrope,Arial,sans-serif}.ds-nav a{display:inline-flex;align-items:center;min-height:40px;padding:8px 19px;border-radius:30px;color:var(--studio-ink);text-decoration:none;transition:background .3s}.ds-nav a:hover,.ds-nav a[aria-current]{background:#f4f4f416}.ds-primary:focus-visible,.ds-text-action:focus-visible,.ds-nav a:focus-visible,.ds-tab:focus-visible,.ds-disclosure summary:focus-visible,.ds-caption:focus-visible{outline:2px solid var(--studio-accent);outline-offset:5px}@supports not (backdrop-filter:blur(1px)){.ds-nav{background:#232326ed}}"
    },
    {
      "name": "Starting-price pill",
      "kind": "chip",
      "refersTo": "price-chip",
      "description": "A noninteractive scope label with a quiet fill and tabular numerals.",
      "html": "<span class=\"ds-price\">от 30 000 ₽</span>",
      "css": ".ds-price{display:inline-block;padding:6px 11px;border:0;border-radius:25px;background:#ffffff0d;color:var(--studio-ink);font:400 11px/1.6 Manrope,Arial,sans-serif;font-variant-numeric:tabular-nums;white-space:nowrap}"
    },
    {
      "name": "Included-work card",
      "kind": "card",
      "refersTo": "included-card",
      "description": "A borderless scope group whose tonal wash carries the grouping.",
      "html": "<article class=\"ds-scope\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 5h16v14H4zM4 9h16M9 9v10\"/></svg><h3>Интерфейс</h3><p>Основной сценарий, экраны и состояния.</p></article>",
      "css": ".ds-scope{display:block;border:0;border-radius:16px;padding:26px;background:#ffffff06;color:var(--studio-ink);font-family:Manrope,Arial,sans-serif;min-height:170px}.ds-scope svg{width:19px;height:19px;color:var(--studio-accent);margin:0 0 18px}.ds-scope h3{margin:0 0 11px;font-size:19px;font-weight:500;line-height:1.35;letter-spacing:-.02em}.ds-scope p{margin:0;color:var(--studio-muted);font-size:14px;line-height:1.65;max-width:47ch}"
    },
    {
      "name": "Production tab",
      "kind": "button",
      "refersTo": "process-tab",
      "description": "The selected phase gets a tonal wash and a rotated drawn arrow.",
      "html": "<button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Интерфейс<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></button>",
      "css": ".ds-tab{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;padding:16px 20px;border:0;border-radius:12px;background:#ffffff06;color:var(--studio-muted);font:400 16px/1.6 Manrope,Arial,sans-serif;text-align:left;cursor:pointer;transition:color .2s}.ds-tab:hover{background:#f4f4f40b}.ds-tab[aria-selected=true]{background:#ffffff15;color:var(--studio-ink)}.ds-tab svg{width:17px;height:17px;transition:transform .3s}.ds-tab[aria-selected=true] svg{color:var(--studio-accent);transform:rotate(45deg)}.ds-primary:focus-visible,.ds-text-action:focus-visible,.ds-nav a:focus-visible,.ds-tab:focus-visible,.ds-disclosure summary:focus-visible,.ds-caption:focus-visible{outline:2px solid var(--studio-accent);outline-offset:5px}"
    },
    {
      "name": "Native disclosure",
      "kind": "custom",
      "refersTo": "faq-row",
      "description": "Native summary interaction with drawn plus/minus strokes and an expanded wash.",
      "html": "<details class=\"ds-disclosure\"><summary>Что передаётся после завершения проекта?<i aria-hidden=\"true\"></i></summary><p>Исходный код, согласованные материалы и инструкции по запуску.</p></details>",
      "css": ".ds-disclosure{padding:0 18px;border:0;border-bottom:1px solid var(--studio-line);color:var(--studio-ink);font-family:Manrope,Arial,sans-serif}.ds-disclosure summary{display:flex;align-items:center;justify-content:space-between;gap:24px;cursor:pointer;list-style:none;min-height:66px;padding:19px 0;font-size:15px;line-height:1.5}.ds-disclosure summary:hover{color:var(--studio-accent)}.ds-disclosure summary::-webkit-details-marker{display:none}.ds-disclosure i{position:relative;width:18px;height:18px;flex:none}.ds-disclosure i:before,.ds-disclosure i:after{content:\"\";position:absolute;left:4px;top:8px;width:10px;height:1px;background:var(--studio-muted)}.ds-disclosure i:after{transform:rotate(90deg);transition:transform .25s}.ds-disclosure[open]{background:#f4f4f409;border-radius:14px;border-bottom-color:transparent}.ds-disclosure[open] i:after{transform:rotate(0)}.ds-disclosure p{margin:0;padding:0 32px 24px 0;color:var(--studio-muted);font-size:14px;line-height:1.8}.ds-primary:focus-visible,.ds-text-action:focus-visible,.ds-nav a:focus-visible,.ds-tab:focus-visible,.ds-disclosure summary:focus-visible,.ds-caption:focus-visible{outline:2px solid var(--studio-accent);outline-offset:5px}"
    },
    {
      "name": "Project overlay caption",
      "kind": "card",
      "refersTo": "project-caption",
      "description": "Readable borderless cover tint with a circular SVG action.",
      "html": "<a class=\"ds-caption\" href=\"#case\"><div><h3>12К</h3><p>Программа лояльности и кабинет бизнеса</p></div><span class=\"ds-caption-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></span></a>",
      "css": ".ds-caption{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 19px;border:0;border-radius:15px;background:#18181bcc;backdrop-filter:blur(22px);color:var(--studio-ink);text-decoration:none;font-family:Manrope,Arial,sans-serif}.ds-caption h3{margin:0 0 5px;font-size:23px;font-weight:500;line-height:1.35;letter-spacing:-.02em}.ds-caption p{margin:0;color:#dcdcdf;font-size:12px;line-height:1.65}.ds-caption-arrow{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--studio-ink);color:var(--studio-ground);flex-shrink:0}.ds-caption-arrow svg{width:21px;height:21px;transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-caption:hover .ds-caption-arrow svg{transform:rotate(45deg)}.ds-primary:focus-visible,.ds-text-action:focus-visible,.ds-nav a:focus-visible,.ds-tab:focus-visible,.ds-disclosure summary:focus-visible,.ds-caption:focus-visible{outline:2px solid var(--studio-accent);outline-offset:5px}@supports not (backdrop-filter:blur(1px)){.ds-caption{background:#232326ed}}"
    },
    {
      "name": "Interface assembly",
      "kind": "custom",
      "refersTo": "diagram-panel",
      "description": "Actual homepage SVG geometry; static preview, with runtime loops visibility-gated on the site.",
      "html": "<div class=\"ds-hero-signal\" aria-hidden=\"true\"><svg class=\"ds-digital-signal\" viewBox=\"0 0 600 390\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n <path class=\"ds-signal-route\" d=\"M72 118H150Q166 118 166 134V185H260M512 218H550V319H438\"/>\n <g class=\"ds-signal-input\"><rect class=\"ds-signal-panel\" x=\"25\" y=\"81\" width=\"132\" height=\"73\" rx=\"12\"/><text x=\"43\" y=\"107\">Ваша идея</text><path class=\"ds-signal-line\" d=\"M44 128h73\"/></g>\n <g class=\"ds-signal-window\"><rect class=\"ds-signal-panel\" x=\"191\" y=\"46\" width=\"325\" height=\"246\" rx=\"14\"/><path class=\"ds-signal-divider\" d=\"M191 80h325\"/><g class=\"ds-signal-dots\"><circle cx=\"207\" cy=\"63\" r=\"2\"/><circle cx=\"216\" cy=\"63\" r=\"2\"/><circle cx=\"225\" cy=\"63\" r=\"2\"/></g><text x=\"214\" y=\"104\">Интерфейс</text><rect class=\"ds-signal-block\" x=\"213\" y=\"122\" width=\"92\" height=\"126\" rx=\"7\"/><rect class=\"ds-signal-block\" x=\"321\" y=\"122\" width=\"173\" height=\"47\" rx=\"7\"/><rect class=\"ds-signal-block\" x=\"321\" y=\"185\" width=\"80\" height=\"63\" rx=\"7\"/><rect class=\"ds-signal-block\" x=\"414\" y=\"185\" width=\"80\" height=\"63\" rx=\"7\"/><path class=\"ds-signal-line\" d=\"M231 143h49\"/><path class=\"ds-signal-line\" d=\"M231 158h33\"/><path class=\"ds-signal-line\" d=\"M338 145h65\"/><path class=\"ds-signal-divider\" d=\"M338 154h122\"/></g>\n <g class=\"ds-signal-output\"><rect class=\"ds-signal-panel\" x=\"118\" y=\"222\" width=\"250\" height=\"125\" rx=\"14\"/><path class=\"ds-signal-divider\" d=\"M118 256h250\"/><g class=\"ds-signal-dots\"><circle cx=\"134\" cy=\"239\" r=\"2\"/><circle cx=\"143\" cy=\"239\" r=\"2\"/><circle cx=\"152\" cy=\"239\" r=\"2\"/></g><text x=\"138\" y=\"280\">Система</text><path class=\"ds-signal-line\" d=\"M139 299h160\"/><path class=\"ds-signal-line\" d=\"M139 314h102\"/><path class=\"ds-signal-check\" d=\"m319 274 9 9 15-19\"/></g>\n <g class=\"ds-signal-node\"><rect class=\"ds-signal-panel\" x=\"443\" y=\"291\" width=\"97\" height=\"53\" rx=\"12\"/><text x=\"462\" y=\"323\">Запуск</text><path class=\"ds-signal-check\" d=\"m515 324 8-8m-8 0h8v8\"/></g>\n <path class=\"ds-signal-trace\" d=\"M72 118H150Q166 118 166 134V185H191\"/>\n <path class=\"ds-signal-trace ds-signal-trace-late\" d=\"M512 218H550V319H540\"/>\n <g class=\"ds-signal-cursor\"><path d=\"m409 149 2 27 8-7 10 3Z\" fill=\"#f5f5f5\"/><circle class=\"ds-signal-click\" cx=\"411\" cy=\"153\" r=\"13\"/></g>\n </svg><span class=\"ds-signal-caption\">Дизайн · Разработка · Интеграции</span></div>",
      "css": ".ds-hero-signal{position:relative;width:100%;max-width:620px;margin:auto;aspect-ratio:600/430;font-family:Manrope,Arial,sans-serif}.ds-digital-signal{display:block;width:100%;height:auto;overflow:visible}.ds-signal-panel{fill:#242426;stroke:#68686e;stroke-width:.9}.ds-signal-block{fill:#303034}.ds-signal-bright{fill:#dddde0}.ds-signal-line{stroke:#9d9da4;stroke-width:3;stroke-linecap:round}.ds-signal-divider{stroke:#58585e;stroke-width:1}.ds-signal-dots{fill:#9c9ca3}.ds-digital-signal text{fill:#dfdfe3;font-family:Manrope,Arial,sans-serif;font-size:15px;font-weight:400;letter-spacing:-.3px}.ds-signal-route{stroke:#55555c;stroke-width:1.1;stroke-linecap:round;stroke-linejoin:round}.ds-signal-check{stroke:#dfdfe3;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-signal-trace{stroke:#eeeef0;stroke-width:2;stroke-dasharray:12 230;stroke-linecap:round;opacity:.8}.ds-signal-click{stroke:#dcdce1;stroke-width:1;opacity:0}.ds-signal-caption{display:block;text-align:center;color:#9d9da3;font-size:11px;margin-top:10px;letter-spacing:.02em}"
